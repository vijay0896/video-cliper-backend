PORT=8000
NODE_ENV=development

# Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Storage & Output Directory paths
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Client Origins for CORS (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5175

